{
  "manifest_version": 3,
  "name": "WaitPlay",
  "version": "1.0.0",
  "description": "Detects slow network requests and offers a quick falling-stars mini-game while you wait.",
  "permissions": ["webRequest", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
